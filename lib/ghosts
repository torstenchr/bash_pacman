# PRAGMA: Use once and only as sourced
if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then echo "The file ${BASH_SOURCE[0]} can only be sourced!"; exit 1; fi
if [ -n "$SOURCE_GHOSTS" ]; then return; fi


source "$SCRIPT_DIR/lib/ghost"
source "$SCRIPT_DIR/lib/log"

#__GHOST_ICON="ᗣ"
__GHOST_ICON_NORMAL="#"
__GHOST_ICON_EATEN=":"
__GHOST_ICON="$__GHOST_ICON_NORMAL"

__GHOST_A_COLOUR="\e[38;5;196m"
__GHOST_B_COLOUR="\e[38;5;217m"
__GHOST_C_COLOUR="\e[38;5;51m"
__GHOST_D_COLOUR="\e[38;5;214m"
__GHOST_WHITE_COLOUR="\e[38;5;231m"
__GHOST_RESET_COLOUR="\e[00m"

__GHOST_A_POS=(1 1)
__GHOST_A_DIRECTION="right"
__GHOST_A_ICON="$__GHOST_ICON"

__GHOST_B_POS=(26 1)
__GHOST_B_DIRECTION="left"
__GHOST_B_ICON="$__GHOST_ICON"

__GHOST_C_POS=(1 29)
__GHOST_C_DIRECTION="right"
__GHOST_C_ICON="$__GHOST_ICON"

__GHOST_D_POS=(26 29)
__GHOST_D_DIRECTION="left"
__GHOST_D_ICON="$__GHOST_ICON"


ghosts::_ghost-icon() {
    local col="$1"
    local row="$2"
    local result="?"
    
    (( col==__GHOST_A_POS[0] )) && ((row==__GHOST_A_POS[1])) && result="$__GHOST_A_ICON"
    (( col==__GHOST_B_POS[0] )) && ((row==__GHOST_B_POS[1])) && result="$__GHOST_B_ICON"
    (( col==__GHOST_C_POS[0] )) && ((row==__GHOST_C_POS[1])) && result="$__GHOST_C_ICON"
    (( col==__GHOST_D_POS[0] )) && ((row==__GHOST_D_POS[1])) && result="$__GHOST_D_ICON"

	echo "$result"
}

ghost::_set-colour-icons() {
    local type="$1"

    case "$type" in
        "default") 
            __GHOST_A_ICON="${__GHOST_A_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            __GHOST_B_ICON="${__GHOST_B_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            __GHOST_C_ICON="${__GHOST_C_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            __GHOST_D_ICON="${__GHOST_D_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            ;;
        "white")
            __GHOST_A_ICON="${__GHOST_WHITE_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            __GHOST_B_ICON="${__GHOST_WHITE_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            __GHOST_C_ICON="${__GHOST_WHITE_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            __GHOST_D_ICON="${__GHOST_WHITE_COLOUR}${__GHOST_ICON}${__GHOST_RESET_COLOUR}"
            ;;
    esac
}

ghosts::init() {
    map::set-icon-callback "$MAP_CELL_GHOST" "ghosts::_ghost-icon"
    ghost::init "${__GHOST_A_POS[@]}"
    ghost::init "${__GHOST_B_POS[@]}"
    ghost::init "${__GHOST_C_POS[@]}"
    ghost::init "${__GHOST_D_POS[@]}"

    ghost::_set-colour-icons "default"
}

ghosts::update() {
    ghost::update "__GHOST_A_POS" "__GHOST_A_DIRECTION"  
    ghost::update "__GHOST_B_POS" "__GHOST_B_DIRECTION"  
    ghost::update "__GHOST_C_POS" "__GHOST_C_DIRECTION"  
    ghost::update "__GHOST_D_POS" "__GHOST_D_DIRECTION"  
}

ghosts::bonus-activated() {
    log "GHOST: bonus activated"
    # Change colour to white
    # Actively move away from pacman if possible (without moving backwards)
    ghost::_set-colour-icons "white"    
}

ghosts::bonus-deactivated() {
    log "GHOST: bonus deactivated"
    # Restore base colours
    # Start moving according to normal algorithm
    ghost::_set-colour-icons "default"
}

ghosts::eat() {
    
}

SOURCE_GHOSTS=1